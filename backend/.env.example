# Copia este archivo como ".env" para cambiar la configuración. Todo es opcional.
# (Todas las variables empiezan con PREVAL_)

# Clave para firmar sesiones. Si no la pones, se genera una sola vez y se guarda en data/secret_key.txt
# PREVAL_SECRET_KEY=

# Base de datos. Por defecto es un archivo SQLite en data/prevalidador.db
# PREVAL_DATABASE_URL=sqlite:///./data/prevalidador.db

# OCR (solo para fotos y escaneos). En Windows, si Tesseract no está en el PATH:
# PREVAL_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# PREVAL_OCR_LANG=spa

# Poner en true cuando se sirva por HTTPS
# PREVAL_COOKIE_SECURE=false
